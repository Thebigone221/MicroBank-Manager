<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="f" uri="http://microbank.sn/functions" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%
    String flashSuccess = (String) session.getAttribute("flashSuccess");
    String flashError = (String) session.getAttribute("flashError");
    if (flashSuccess != null) { session.removeAttribute("flashSuccess"); }
    if (flashError != null) { session.removeAttribute("flashError"); }
    request.setAttribute("flashSuccess", flashSuccess);
    request.setAttribute("flashError", flashError);

    String cheminActuel = request.getRequestURI().substring(request.getContextPath().length());
    request.setAttribute("cheminActuel", cheminActuel);
%>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>MicroBank Manager</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/bootstrap-icons.min.css">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-microbank no-print">
    <div class="container-fluid px-4">
        <a class="navbar-brand fw-bold" href="${pageContext.request.contextPath}/dashboard">
            <span class="marque" aria-hidden="true"><i class="bi bi-bank2"></i></span>MICROBANK
        </a>
        <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse"
                data-bs-target="#menuPrincipal" aria-controls="menuPrincipal">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menuPrincipal">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link ${cheminActuel eq '/dashboard' ? 'active' : ''}"
                       href="${pageContext.request.contextPath}/dashboard">
                        <i class="bi bi-speedometer2 me-1"></i>Tableau de bord
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${cheminActuel.startsWith('/clients') ? 'active' : ''}"
                       href="${pageContext.request.contextPath}/clients">
                        <i class="bi bi-people me-1"></i>Clients
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${cheminActuel.startsWith('/accounts') ? 'active' : ''}"
                       href="${pageContext.request.contextPath}/accounts">
                        <i class="bi bi-wallet2 me-1"></i>Comptes
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${cheminActuel.startsWith('/operations') ? 'active' : ''}"
                       href="${pageContext.request.contextPath}/operations">
                        <i class="bi bi-arrow-left-right me-1"></i>Opérations
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${cheminActuel.startsWith('/agencies') ? 'active' : ''}"
                       href="${pageContext.request.contextPath}/agencies">
                        <i class="bi bi-building me-1"></i>Agences
                    </a>
                </li>
                <c:if test="${sessionScope.user.role == 'ADMIN'}">
                    <li class="nav-item">
                        <a class="nav-link ${cheminActuel.startsWith('/users') ? 'active' : ''}"
                           href="${pageContext.request.contextPath}/users">
                            <i class="bi bi-person-gear me-1"></i>Utilisateurs
                        </a>
                    </li>
                </c:if>
            </ul>
            <ul class="navbar-nav">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="menuUtilisateur" role="button"
                       data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle me-1"></i>
                            ${fn:escapeXml(sessionScope.user.nomComplet)}
                        <span class="badge badge-role ms-1">${sessionScope.user.role}</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="menuUtilisateur">
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" href="${pageContext.request.contextPath}/logout">
                                <i class="bi bi-box-arrow-right me-1"></i>Déconnexion
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="container py-4">

    <c:if test="${not empty flashSuccess}">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>${flashSuccess}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    </c:if>
    <c:if test="${not empty flashError}">
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>${flashError}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    </c:if>
